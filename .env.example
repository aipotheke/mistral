# Token used to authorize all HiDrive API requests (OAuth2 access token).
# This is the only required value.
HIDRIVE_ACCESS_TOKEN=

# Optional: enable automatic refresh of short-lived access tokens.
# If all three are set, the client will refresh the access token when it 401s.
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_REFRESH_TOKEN=
